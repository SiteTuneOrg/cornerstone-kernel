<?xml version="1.0" encoding="UTF-8"?>
<!-- Double-entry bookkeeping kernel, standalone lib. See README.md. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.cornerstone</groupId>
  <artifactId>cornerstone-kernel</artifactId>
  <version>0.3.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>6.1.3</junit.version>
    <spotbugs.version>4.10.4.1</spotbugs.version>
    <findsecbugs.version>1.14.0</findsecbugs.version>
    <pitest.version>1.30.0</pitest.version>
  </properties>

  <!--
    Published to GitHub Packages (SPEC_RELEASE D9 in cornerstone-app): the server depends on a
    released version instead of building this repository's main, so a commit here no longer changes
    the server's build behind its back. `.github/workflows/publish.yml` deploys on a tag vX.Y.Z whose
    number is this pom's version.
  -->
  <distributionManagement>
    <repository>
      <id>github</id>
      <url>https://maven.pkg.github.com/SiteTuneOrg/cornerstone-kernel</url>
    </repository>
  </distributionManagement>

  <!--
    This is the kernel only: the double-entry object model, no persistence.
    Zero compile-time dependencies beyond the JDK. A database-backed module
    (JDBC, an ORM, whatever) is a separate future project layered on top of
    this one's public types — see README.md.
  -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.0</version>
      </plugin>
      <!-- The build's own invariants: the Maven and Java this README promises, and the kernel's
           promise of zero compile-time dependencies (a compile-scoped dependency fails here
           instead of slipping in through a review). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>enforce</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireMavenVersion><version>[3.9,)</version></requireMavenVersion>
                <requireJavaVersion><version>[25,)</version></requireJavaVersion>
                <bannedDependencies>
                  <excludes><exclude>*:*:*:*:compile</exclude></excludes>
                  <message>The kernel has zero compile-time dependencies (README.md).</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Static analysis gate: SpotBugs with FindSecBugs fails `verify` on any finding at the
           default threshold. A deliberate exception goes in spotbugs-exclude.xml with the reason
           beside it, never as a lower threshold. -->
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>${spotbugs.version}</version>
        <configuration>
          <effort>Max</effort>
          <excludeFilterFile>spotbugs-exclude.xml</excludeFilterFile>
          <plugins>
            <plugin>
              <groupId>com.h3xstream.findsecbugs</groupId>
              <artifactId>findsecbugs-plugin</artifactId>
              <version>${findsecbugs.version}</version>
            </plugin>
          </plugins>
        </configuration>
        <executions>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
      </plugin>
      <!-- Mutation gate: PIT mutates the main code and fails `verify` when the tests kill fewer
           mutants than mutationThreshold. Line coverage says a line ran; this says a test would
           notice it being wrong, which is what an invariant of the kernel needs. Measured at 82% on
           2026-10-10 (337 mutants, about a minute); the gate is 80, like the line gate. Raise it as
           tests improve, never lower it to pass. Report: target/pit-reports/. -->
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>${pitest.version}</version>
        <dependencies>
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>1.2.3</version>
          </dependency>
        </dependencies>
        <configuration>
          <targetClasses><param>com.cornerstone.ledger.*</param></targetClasses>
          <targetTests><param>com.cornerstone.ledger.*</param></targetTests>
          <mutationThreshold>80</mutationThreshold>
          <outputFormats><param>HTML</param><param>XML</param></outputFormats>
          <timestampedReports>false</timestampedReports>
        </configuration>
        <executions>
          <execution>
            <id>mutation-gate</id>
            <phase>verify</phase>
            <goals><goal>mutationCoverage</goal></goals>
          </execution>
        </executions>
      </plugin>
      <!-- Coverage gate: `verify` fails when total line coverage is below 80%
           (also run by .githooks/pre-commit). Report: target/site/jacoco/.
           Report without failing: -Djacoco.haltOnFailure=false.
           0.8.14+ is required for Java 25.
           If surefire ever gets an <argLine>, prefix it with @{argLine}. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.15</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
