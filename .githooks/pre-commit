#!/usr/bin/env bash
# Coverage gate: blocks the commit when total line coverage is below 80%
# (jacoco-maven-plugin `check` execution in pom.xml, bound to `verify`).
#
# Enable once per clone: git config core.hooksPath .githooks
# Caveat: tests run against the working tree, not the exact staged snapshot.
# Bypass (use sparingly): git commit --no-verify
set -euo pipefail

# pom.xml and .mvn/ too: they carry the gate's own configuration.
git diff --cached --quiet -- src/ pom.xml .mvn/ && exit 0

./mvnw -q verify
